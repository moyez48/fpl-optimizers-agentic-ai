# Local dev — Vite dev server proxies /api → FastAPI (default port 8006)
VITE_API_PROXY=http://127.0.0.1:8006

# Production / preview builds (Vercel, etc.) — public FastAPI origin, no trailing slash
# Routes append /api/* in code, e.g. VITE_API_BASE=https://moyez48-pitchcraft-api.hf.space

# Pitchcraft: optional FPL entry ID for live squad bootstrap (backend calls official FPL API)
# VITE_FPL_ENTRY_ID=123456
